  - m_Id: 4040180184682496
    m_Localized: Volume Master
    m_Metadata:
      m_Items: []
  - m_Id: 4040311575449600
    m_Localized: "M\xFAsica"
    m_Metadata:
      m_Items: []
  - m_Id: 4040454915788800
    m_Localized: "Pressione qualquer bot\xE3o para come\xE7ar"
    m_Metadata:
      m_Items: []
  - m_Id: 4043618872233984
    m_Localized: "\"Use A/D ou \n\u2190/\u2192 para andar\"\n\"Use o anal\xF3gico
      esquerdo para andar (controle)\""
    m_Metadata:
      m_Items: []
  - m_Id: 4043654687395840
    m_Localized: "\"Use W/Espa\xE7o/\u2191 para pular\"\n\"Aperte A para pular (Controle)\""
    m_Metadata:
      m_Items: []
  - m_Id: 4043675671498752
    m_Localized: '"Segure SHIFT para correr

      Cuidado com a Stamina!"

      "Pressione
      RT no Controle"'
    m_Metadata:
      m_Items: []
  - m_Id: 4045222438539264
    m_Localized: '"Alguns Power-Ups podem melhorar suas habilidades temporariamente!"'
    m_Metadata:
      m_Items: []
  - m_Id: 4045231221411840
    m_Localized: "\"Evite Obst\xE1culos! Proteja a Caixa.\""
    m_Metadata:
      m_Items: []
  - m_Id: 4045241354850304
    m_Localized: '"Agora um pequeno desafio"'
    m_Metadata:
      m_Items: []
  - m_Id: 4045243212926976
    m_Localized: '"Cuidado com os buracos!"'
    m_Metadata:
      m_Items: []
  - m_Id: 4045244806762496
    m_Localized: "\"Pegue ossos para conseguir \npontua\xE7\xF5es especiais e melhores!\""
    m_Metadata:
      m_Items: []
