  - m_Id: 12701970506485760
    m_Localized: SAIR
    m_Metadata:
      m_Items: []
  - m_Id: 12701986767802368
    m_Localized: REINICIAR
    m_Metadata:
      m_Items: []
  - m_Id: 12702006682357760
    m_Localized: "PR\xD3XIMA \nFASE"
    m_Metadata:
      m_Items: []
  - m_Id: 13527607441920000
    m_Localized: COMO JOGAR?
    m_Metadata:
      m_Items: []
  - m_Id: 13527864519200768
    m_Localized: "VOC\xCA TEM CERTEZA?"
    m_Metadata:
      m_Items: []
  - m_Id: 13530401305563136
    m_Localized: SIM
    m_Metadata:
      m_Items: []
  - m_Id: 13530424009330688
    m_Localized: "N\xC3O"
    m_Metadata:
      m_Items: []
  - m_Id: 13531325289762816
    m_Localized: "SELE\xC7\xC3O DE FASES"
    m_Metadata:
      m_Items: []
  - m_Id: 14190332857847808
    m_Localized: ENTREGA FALHA!
    m_Metadata:
      m_Items: []
  - m_Id: 14201587186307072
    m_Localized: "TUTORIAL CONCLU\xCDDO!"
    m_Metadata:
      m_Items: []
  - m_Id: 14202783393419264
    m_Localized: "PR\xD3XIMA FASE"
    m_Metadata:
      m_Items: []
  - m_Id: 14221373299527680
    m_Localized: OBRIGADO POR JOGAR!
    m_Metadata:
      m_Items: []
  - m_Id: 14221989321150464
    m_Localized: "AT\xC9 A PROXIMA ENTREGA!"
    m_Metadata:
      m_Items: []
  - m_Id: 14222526951231488
    m_Localized: "APERTE QUALQUER BOT\xC3O PARA PROSSEGUIR..."
    m_Metadata:
      m_Items: []
