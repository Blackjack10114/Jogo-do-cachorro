  - m_Id: 88960962560
    m_Localized: JOGAR
    m_Metadata:
      m_Items: []
  - m_Id: 5914178129920
    m_Localized: "OP\xC7\xD5ES"
    m_Metadata:
      m_Items: []
  - m_Id: 5982960521216
    m_Localized: "CR\xC9DITOS"
    m_Metadata:
      m_Items: []
  - m_Id: 6043463356416
    m_Localized: SAIR
    m_Metadata:
      m_Items: []
  - m_Id: 4035600289927168
    m_Localized: PROGRAMADOR
    m_Metadata:
      m_Items: []
  - m_Id: 4037721114578944
    m_Localized: VOLTAR
    m_Metadata:
      m_Items: []
  - m_Id: 4037799258656768
    m_Localized: ARTISTA
    m_Metadata:
      m_Items: []
  - m_Id: 4038045183283200
    m_Localized: "GAME DESIGNER / \nPROGRAMADOR"
    m_Metadata:
      m_Items: []
  - m_Id: 4040180184682496
    m_Localized: MASTER
    m_Metadata:
      m_Items: []
  - m_Id: 4040311575449600
    m_Localized: "M\xDASICA"
    m_Metadata:
      m_Items: []
  - m_Id: 4040454915788800
    m_Localized: "PRESSIONE QUALQUER BOT\xC3O PARA COME\xC7AR!"
    m_Metadata:
      m_Items: []
  - m_Id: 4043618872233984
    m_Localized: "\"Use A/D ou \n\u2190/\u2192 para andar\"\n\"Use o anal\xF3gico
      esquerdo para andar (controle)\""
    m_Metadata:
      m_Items: []
  - m_Id: 4043654687395840
    m_Localized: "\"Use W/Espa\xE7o/\u2191 para pular\"\n\"Aperte A para pular (Controle)\""
    m_Metadata:
      m_Items: []
  - m_Id: 4043675671498752
    m_Localized: '"Segure SHIFT para correr

      Cuidado com a Stamina!"

      "Pressione
      RT no Controle"'
    m_Metadata:
      m_Items: []
  - m_Id: 4045222438539264
    m_Localized: '"Alguns Power-Ups podem melhorar suas habilidades temporariamente!"'
    m_Metadata:
      m_Items: []
  - m_Id: 4045231221411840
    m_Localized: "\"Evite Obst\xE1culos! Proteja a Caixa.\""
    m_Metadata:
      m_Items: []
  - m_Id: 4045241354850304
    m_Localized: '"Agora um pequeno desafio"'
    m_Metadata:
      m_Items: []
  - m_Id: 4045243212926976
    m_Localized: '"Cuidado com os buracos!"'
    m_Metadata:
      m_Items: []
  - m_Id: 4045244806762496
    m_Localized: "\"Pegue ossos para conseguir \npontua\xE7\xF5es especiais e melhores!\""
    m_Metadata:
      m_Items: []
  - m_Id: 12658715693715456
    m_Localized: "ENTREGA CONCLU\xCDDA"
    m_Metadata:
      m_Items: []
  - m_Id: 12658769670213632
    m_Localized: NOTA:{0}
    m_Metadata:
      m_Items:
      - rid: 289343686959431781
