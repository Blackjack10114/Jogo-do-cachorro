    m_Metadata:
      m_Items: []
  - m_Id: 4040454915788800
    m_Localized: '       PRESS ANY BUTTON TO START!'
    m_Metadata:
      m_Items: []
  - m_Id: 4043618872233984
    m_Localized: "\"Use A/D or \n\u2190/\u2192 to walk\"\n\"Move the Left Stick to
      walk (Controller)\""
    m_Metadata:
      m_Items: []
  - m_Id: 4043654687395840
    m_Localized: "\"Use W/Espa\xE7o/\u2191 to jump\"\n\"Use A to jump (Controller)\""
    m_Metadata:
      m_Items: []
  - m_Id: 4043675671498752
    m_Localized: '"Hold SHIFT to run

      Be careful with your stamina!"

      "Press
      RT on Controller"'
    m_Metadata:
      m_Items: []
  - m_Id: 4045222438539264
    m_Localized: '"Some Power-Ups can upgrade your habilities temporarily!"'
    m_Metadata:
      m_Items: []
  - m_Id: 4045231221411840
    m_Localized: '"Avoid obstacles! Protect the box."'
    m_Metadata:
      m_Items: []
  - m_Id: 4045241354850304
    m_Localized: '"Now a little challenge"'
    m_Metadata:
      m_Items: []
  - m_Id: 4045243212926976
    m_Localized: '"Be careful with pits!"'
    m_Metadata:
      m_Items: []
  - m_Id: 4045244806762496
    m_Localized: "\"Grab bones to get \nBetter and special scores!\""
    m_Metadata:
      m_Items: []
